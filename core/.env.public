# =============================================================
# MMEAN 공개 환경 설정 — API 키·시크릿 없이 GitHub 공개 가능
# 실제 키 값은 .env.secrets 에만 기록하세요 (gitignored)
# =============================================================

# 한투 환경 (live / paper)
KIS_ENV=live

# 데이터 소스 / 종목 코드
MMEAN_DATA_SOURCE=live_ws
MMEAN_FUTURES_CODE=A01606
MMEAN_SPOT_CODE=2001

# 서버 포트
MMEAN_PORT=5001

# 엔진 파라미터
MMEAN_LOOP_INTERVAL_SEC=1.0
MMEAN_EMA_ALPHA=0.18
MMEAN_SLOPE_WINDOW=14
MMEAN_VOLUME_WINDOW=20
MMEAN_LOG_LEVEL=INFO

# 야간 세션 사용 시 아래 주석 해제
#MMEAN_SESSION=night
#MMEAN_WS_URL=ws://ops.koreainvestment.com:21000

# 투자자 동향 구독
MMEAN_USE_INVESTOR=1
MMEAN_INVESTOR_MARKET_CODE=K2I
MMEAN_INVESTOR_SUB_CODE=F001

# 시뮬레이션 리스크 파라미터
MMEAN_SIM_TP_TICKS=0
MMEAN_SIM_SL_TICKS=25
MMEAN_SIM_TRAILING_TICKS=12
MMEAN_SIM_TRAILING_ACTIVATE=8
MMEAN_SIM_NEUTRAL_EXIT_TICKS=80
MMEAN_SIM_FORCE_EXIT_HOUR=5
MMEAN_SIM_FORCE_EXIT_MIN=50

# 1순위 (개장 전 전략 - 가장 똑똑한 녀석)
LLM_MODEL_CLAUDE=claude-sonnet-4-5

# 2순위 (장중 지휘 - 빠르고 정확한 녀석)
LLM_MODEL_GPT=gpt-4o-mini

# 3순위 (리포트 및 백업 - 가성비와 대용량)
LLM_MODEL_GEMINI=gemini-2.0-flash
REPORT_GEMINI_MODEL=gemini-2.0-flash

# LLM HTTP 타임아웃 (기본값 2초는 GPT/Gemini 폴백 시 너무 짧음)
LLM_CONNECT_TIMEOUT_SEC=2
LLM_TIMEOUT_SEC=8