# =============================================================
# MMEAN 공개 환경 설정 — API 키·시크릿 없이 GitHub 공개 가능
# 실제 키 값은 .env.secrets 에만 기록하세요 (gitignored)
# =============================================================


# ══════════════════════════════════════════════════════════════
# KIS API 계좌 환경 설정
# ══════════════════════════════════════════════════════════════

KIS_ENV=live                  # (구버전 호환 레거시 키) 데이터 계좌 환경. live 고정.
                              # KIS_DATA_ENV 로 대체됐으나 이전 코드 호환을 위해 유지.
                              # 변경 금지 — KIS 실계좌만 지표 REST API를 허용함.

KIS_DATA_ENV=live             # 시세·지표 조회용 실계좌 환경. live 고정.
                              # 외국인 수급·투자자 동향·현재가 등 모든 데이터 REST는 이 계좌로.
                              # virtual 로 바꾸면 지표 API 대부분이 403 오류 발생.
                              # 변경 금지.

KIS_ORDER_ENV=virtual         # 주문 전송 대상 계좌 환경.
                              # virtual = 모의계좌 (개발/테스트용, REST :29443 / WS :31000)
                              # live    = 실계좌 (실거래, REST :9443 / WS :21000)
                              # 이 값이 virtual 이면 실계좌 키를 써도 모의 서버로 연결됨.
                              # 실거래 전환 시: KIS_ORDER_ENV=live 로 변경 후 재시작.


# ══════════════════════════════════════════════════════════════
# 주문 실행 게이트 (안전 스위치)
# ══════════════════════════════════════════════════════════════

MMEAN_EXECUTION_ENABLED=false # 실주문 발사 여부 최종 게이트.
                              # false(기본) = dry-run 모드. 신호가 발생해도 주문 전송 안 함.
                              #              로그에 [EXEC-DRY] 로 신호 방향/수량만 기록.
                              # true        = execute_entry/exit 실제 호출.
                              #              KIS_ORDER_ENV 가 가리키는 서버에 실제 주문 전송.
                              # ※ 대시보드 실행 모드 버튼과 독립된 하드웨어 안전핀.
                              #   이 값이 false 면 대시보드에서 LIVE 버튼을 눌러도 주문 안 나감.


# ══════════════════════════════════════════════════════════════
# 크래시 복구 정책
# ══════════════════════════════════════════════════════════════

MMEAN_CRASH_RECOVERY=close    # 프로그램 재시작 후 미청산 포지션이 KIS 서버에 남아 있을 때 처리 방식.
                              # close  (기본) = 즉시 execute_exit() 호출해 시장가 청산.
                              #                 무인 서버·방치 서버 권장값.
                              #                 크래시 원인 불명 상태에서 포지션을 안고 가는 것보다 안전.
                              # resume        = 포지션을 in-memory 에 복원하고 TP/SL 감시 재개.
                              #                 trail_peak_ticks 는 0 으로 리셋됨 (trail 상태 소실).
                              #                 개발 중·관리자 모니터링 서버에 적합.
                              # ※ EXECUTION_ENABLED=false 이면 이 설정은 무시됨 (주문 자체가 비활성).


# ══════════════════════════════════════════════════════════════
# 무인 서버 자동 LIVE 시작
# ══════════════════════════════════════════════════════════════

MMEAN_LIVE_AUTOSTART=false    # EXECUTION_ENABLED=true 일 때 시작 비밀번호 프롬프트 건너뛸지 여부.
                              # false(기본) = 시작 시 콘솔에 비밀번호 입력 요구.
                              #               30초 내 미입력(타임아웃) 또는 불일치 → 시뮬레이션 강제 전환.
                              #               개발 서버·직접 실행 환경 권장.
                              # true        = .env.secrets 의 MMEAN_LIVE_PASSWORD 를 자동 인증으로 간주,
                              #               비밀번호 없이 LIVE 모드로 자동 시작.
                              #               systemd·cron·Docker 등 무인 재시작 환경 전용.
                              #               이 서버의 .env.secrets 파일 접근이 완전히 통제되는 경우에만 사용.


# ══════════════════════════════════════════════════════════════
# 데이터 소스 및 종목 코드
# ══════════════════════════════════════════════════════════════

MMEAN_DATA_SOURCE=live_ws     # 시세 데이터 수신 방식.
                              # live_ws  (기본) = KIS WebSocket 실시간 구독 (H0IFCNT0).
                              #                   실제 장 운영 시 이 값 사용.
                              # replay          = 로컬 파일 재생 (백테스트용, 미구현 시 fallback).

MMEAN_FUTURES_CODE=A01606     # KOSPI 200 선물 종목 단축코드 (shtn_pdno).
                              # 만기월마다 바뀜. 예) 3월물=A01606, 6월물=A01609.
                              # KIS HTS 또는 apiportal 종목 목록에서 현재 근월물 코드 확인 후 갱신.

MMEAN_SPOT_CODE=2001          # KOSPI 200 현물 지수 코드.
                              # 투자자 동향(FHPTJ04030000) REST 호출 시 사용.
                              # 통상 고정값 — 변경 불필요.


# ══════════════════════════════════════════════════════════════
# 서버
# ══════════════════════════════════════════════════════════════

MMEAN_PORT=5001               # Flask 웹 서버 포트.
                              # 대시보드 접속: http://localhost:5001
                              # 다른 프로그램과 충돌 시 변경 (예: 5002).


# ══════════════════════════════════════════════════════════════
# 엔진 루프 파라미터
# ══════════════════════════════════════════════════════════════

MMEAN_LOOP_INTERVAL_SEC=1.0   # 엔진 메인 루프 주기 (초).
                              # 값이 작을수록 반응 빠르지만 CPU 사용 증가.
                              # 0.5 = 빠른 반응 (장중 고빈도), 1.0 = 기본, 2.0 = 저부하.
                              # WebSocket 틱은 별도 스레드라 이 값과 무관하게 수신됨.

MMEAN_EMA_ALPHA=0.18          # 가격 EMA(지수이동평균) 평활 계수. 범위: 0.0 ~ 1.0.
                              # 값이 클수록 최신 가격 반영 비중 높음 (빠른 반응).
                              # 값이 작을수록 과거 가격 비중 높음 (느린 반응, 노이즈 억제).
                              # 0.18 ≈ 약 10틱 EMA 에 해당.

MMEAN_SLOPE_WINDOW=14         # 가격 기울기(slope) 계산에 사용하는 EMA 틱 수.
                              # 최근 N 틱의 EMA 선형회귀 기울기로 추세 방향 판단.
                              # 값이 클수록 추세 판단이 완만해지고 신호 빈도 감소.

MMEAN_VOLUME_WINDOW=20        # 거래량 이동평균 계산 윈도우 크기 (틱 수).
                              # 현재 거래량 / 평균 거래량 비율로 거래량 급증 감지.
                              # 값이 클수록 평균 기준이 안정적이나 급등 감지 느려짐.

MMEAN_LOG_LEVEL=INFO          # 로그 출력 레벨.
                              # DEBUG   = 틱 데이터·EMA 값 등 모든 내부 상태 출력 (로그 매우 많음).
                              # INFO    = 신호·주문·체결·포지션 변화 등 주요 이벤트만 출력 (기본).
                              # WARNING = 오류·비정상 상황만 출력.
                              # ERROR   = 심각한 오류만 출력.


# ══════════════════════════════════════════════════════════════
# 야간 세션 (기본 비활성 — 주석 해제 시 활성)
# ══════════════════════════════════════════════════════════════

#MMEAN_SESSION=night          # 야간 선물 세션 활성화. 주석 해제 시 야간 WS URL 사용.
                              # 야간 세션: 18:00 ~ 익일 05:00 (KST 기준).
                              # 야간 주문 TR ID: STTN1101U (주간과 다름, kis_tr_catalog 참조).

#MMEAN_WS_URL=ws://ops.koreainvestment.com:21000
                              # WebSocket 서버 URL 직접 지정.
                              # 기본값은 KIS_DATA_ENV 로 자동 결정되므로 보통 불필요.
                              # 야간 세션 등 특수 URL 필요 시만 주석 해제.


# ══════════════════════════════════════════════════════════════
# 투자자 동향 (외국인·기관 수급)
# ══════════════════════════════════════════════════════════════

MMEAN_USE_INVESTOR=1          # 외국인·기관 투자자 동향 데이터 수집 활성화.
                              # 1(기본) = 활성. ForeignFlowEngine 이 이 데이터로 수급 방향 판단.
                              # 0       = 비활성. 투자자 동향 없이 가격·거래량만으로 판단.
                              # ※ 이 값이 0 이면 ForeignFlowEngine 신호가 NEUTRAL 고정됨.

MMEAN_INVESTOR_MARKET_CODE=K2I  # 투자자 동향 조회 시장 코드.
                                # K2I = KOSPI 200 선물 시장 (기본, 변경 불필요).
                                # KIS FHPTJ04030000 TR 의 mrkt_cls_code 파라미터에 해당.

MMEAN_INVESTOR_SUB_CODE=F001    # 투자자 동향 세부 구독 코드.
                                # F001 = KOSPI 200 선물 전체 (기본, 변경 불필요).
                                # KIS FHPTJ04030000 TR 의 iscd_stat_cls_code 파라미터에 해당.


# ══════════════════════════════════════════════════════════════
# 시뮬레이션(가상매매) 리스크 파라미터
# 단위: 틱 (KOSPI 200 선물 1틱 = 0.05pt = 12,500원)
# ══════════════════════════════════════════════════════════════

MMEAN_SIM_TP_TICKS=0          # 시뮬레이션 익절 틱 수. 0 = 비활성 (신호 반전 시에만 익절).
                              # 예) 16 → 진입 후 +0.80pt(=20만원) 달성 시 자동 청산.
                              # 0 으로 두면 TP 없이 SL·trailing·신호 반전에만 청산.

MMEAN_SIM_SL_TICKS=25         # 시뮬레이션 손절 틱 수. 0 = 비활성.
                              # 예) 25 → 진입 후 -1.25pt(=31.25만원) 손실 시 강제 청산.
                              # 0 으로 두면 SL 없이 운영 (위험 — 권장하지 않음).

MMEAN_SIM_TRAILING_TICKS=12   # 시뮬레이션 트레일링 스탑 폭 (틱). 0 = 비활성.
                              # 고점 대비 N 틱 이상 되돌리면 청산.
                              # 예) 12 → 고점에서 -0.60pt 되돌림 시 청산.
                              # TRAILING_ACTIVATE 조건 충족 후에만 작동.

MMEAN_SIM_TRAILING_ACTIVATE=8 # 트레일링 스탑 활성화 진입 조건 (틱).
                              # 진입 후 이 틱 이상 수익이 나야 트레일링 감시 시작.
                              # 예) 8 → +0.40pt 이상 수익 후 트레일링 발동.
                              # 너무 작으면 수익 초기에 쉽게 털림.

MMEAN_SIM_NEUTRAL_EXIT_TICKS=80  # 시뮬레이션 중립 신호(NEUTRAL) 청산 기준 (틱).
                                 # NEUTRAL 신호 시 즉시 청산하지 않고 수익이 N 틱 이상일 때만 청산.
                                 # 예) 80 → 수익이 +4.00pt 이상일 때만 NEUTRAL 에 청산.
                                 # 0 으로 두면 NEUTRAL 신호 발생 즉시 무조건 청산.

MMEAN_SIM_FORCE_EXIT_HOUR=5   # 시뮬레이션 강제 청산 시각 — 시(hour). 24시간 기준.
MMEAN_SIM_FORCE_EXIT_MIN=50   # 시뮬레이션 강제 청산 시각 — 분(minute).
                              # 위 두 값 조합: 매일 05:50 에 포지션 강제 청산.
                              # 야간 세션 종료 직전 미청산 포지션 정리 목적.
                              # 주간 세션만 사용 시 15:40 정도로 변경 권장.


# ══════════════════════════════════════════════════════════════
# 실주문 리스크 파라미터 (EXECUTION_ENABLED=true 일 때 적용)
# 단위: 틱 (KOSPI 200 선물 1틱 = 0.05pt = 12,500원)
# ══════════════════════════════════════════════════════════════

MMEAN_LIVE_TP_TICKS=16        # 실주문 익절 틱. 0 = 비활성.
                              # 예) 16 → +0.80pt(=20만원) 달성 시 즉시 청산 주문.

MMEAN_LIVE_SL_TICKS=10        # 실주문 손절 틱. 0 = 비활성.
                              # 예) 10 → -0.50pt(=12.5만원) 손실 시 즉시 청산 주문.
                              # SIM 보다 좁게 설정하는 게 실전 리스크 관리 기본 원칙.

MMEAN_LIVE_TRAILING_TICKS=6   # 실주문 트레일링 스탑 폭 (틱). 0 = 비활성.
                              # 고점 대비 N 틱 되돌림 시 청산.

MMEAN_LIVE_TRAILING_ACTIVATE=8  # 실주문 트레일링 활성화 조건 (틱).
                                # 이 틱 이상 수익 후 트레일링 감시 시작.


# ══════════════════════════════════════════════════════════════
# LLM 모델 설정 (3단계 폴백 체계)
# ══════════════════════════════════════════════════════════════

LLM_MODEL_CLAUDE=claude-sonnet-4-5   # 1순위 — 개장 전 전략 수립용.
                                     # 가장 정확하고 컨텍스트 이해력 높음.
                                     # 개장 전 RAG 기반 시장 분석 및 일일 전략 결정에 사용.
                                     # 비용이 높아 장중 실시간 호출에는 미사용.

LLM_MODEL_GPT=gpt-4o-mini            # 2순위 — 장중 실시간 신호 판단용.
                                     # 빠른 응답 속도 + 합리적 비용. 장중 LLMGate 에서 호출.
                                     # Claude 응답 실패 시 폴백으로도 사용.

LLM_MODEL_GEMINI=gemini-2.0-flash    # 3순위 — 리포트 생성·대용량 텍스트·백업용.
                                     # 무료 티어 활용 가능. GPT 실패 시 폴백.
REPORT_GEMINI_MODEL=gemini-2.0-flash # 일일 리포트 생성 전용 Gemini 모델.
                                     # 리포트는 긴 텍스트를 다루므로 flash 계열이 적합.


# ══════════════════════════════════════════════════════════════
# LLM HTTP 타임아웃
# ══════════════════════════════════════════════════════════════

LLM_CONNECT_TIMEOUT_SEC=2     # LLM API 서버 TCP 연결 타임아웃 (초).
                              # 이 시간 내 연결 안 되면 다음 LLM 으로 폴백.
                              # 너무 크면 폴백 지연 발생 (장중 치명적).

LLM_TIMEOUT_SEC=8             # LLM API 전체 응답 타임아웃 (초).
                              # 연결 성공 후 응답 완료까지 허용 시간.
                              # GPT/Gemini 는 평균 1~3초, 8초면 충분.
                              # 너무 작으면 정상 응답도 타임아웃 처리됨.
